<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ISAGI OS — V1</title><style>
:root{--bg:#07090d;--p:#10141c;--p2:#151b25;--line:#283141;--txt:#f4f7fb;--mut:#9aa6b8;--a:#62e6b2;--b:#7d8cff;--red:#ff6b7a;--yel:#ffd166}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 75% 0,#20284b 0,transparent 34%),var(--bg);color:var(--txt);font:14px Inter,system-ui,sans-serif}.app{display:grid;grid-template-columns:245px 1fr;min-height:100vh}aside{padding:20px 14px;border-right:1px solid var(--line);background:#080a0fcc;backdrop-filter:blur(15px);position:sticky;top:0;height:100vh}.logo{font-weight:900;letter-spacing:.12em}.mut{color:var(--mut)}nav{margin-top:25px;display:grid;gap:5px}nav button{border:0;background:0;color:var(--mut);padding:10px;border-radius:9px;text-align:left}nav button:hover,nav button.on{background:var(--p2);color:var(--txt)}main{padding:25px;max-width:1500px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;margin-bottom:18px}h1{margin:0;font-size:28px}h2{font-size:15px;margin:0 0 13px}.k{color:var(--a);font-weight:800;font-size:10px;letter-spacing:.15em;text-transform:uppercase;margin-bottom:6px}.grid{display:grid;gap:13px}.g4{grid-template-columns:repeat(4,1fr)}.g3{grid-template-columns:repeat(3,1fr)}.g2{grid-template-columns:repeat(2,1fr)}.card{background:linear-gradient(145deg,#121722f2,#0d1118f2);border:1px solid var(--line);border-radius:14px;padding:16px}.big{font-size:29px;font-weight:900}.small{font-size:11px}.bar{height:8px;background:#252c38;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--a),var(--b));border-radius:inherit}.btn{border:1px solid var(--line);background:var(--p);color:var(--txt);padding:9px 12px;border-radius:9px}.primary{background:var(--a);color:#06110d;border-color:var(--a);font-weight:800}.danger{color:var(--red)}.tag{border:1px solid var(--line);border-radius:99px;padding:4px 8px;font-size:10px;color:var(--mut)}.item{border:1px solid var(--line);border-radius:10px;padding:11px;background:#ffffff03}.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.between{display:flex;justify-content:space-between;gap:10px;align-items:center}.section{display:none}.section.on{display:block}.stat{display:grid;gap:6px}.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:18px;z-index:10}.modal.on{display:flex}.box{width:min(720px,100%);max-height:90vh;overflow:auto;background:var(--p);border:1px solid var(--line);border-radius:15px;padding:18px}.form{display:grid;gap:9px}.form input,.form textarea,.form select{width:100%;background:#090c12;color:var(--txt);border:1px solid var(--line);padding:10px;border-radius:8px}.form textarea{min-height:85px}.toast{display:none;position:fixed;right:16px;bottom:16px;background:#eafff6;color:#06110d;padding:11px 14px;border-radius:9px;font-weight:800;z-index:20}.toast.on{display:block}.line{line-height:1.6}@media(max-width:850px){.app{display:block}aside{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--line)}nav{grid-template-columns:repeat(4,1fr)}main{padding:16px}.g4,.g3,.g2{grid-template-columns:1fr 1fr}}@media(max-width:520px){.g4,.g3,.g2{grid-template-columns:1fr}.top{flex-direction:column}}
</style></head><body><div class="app"><aside><div class="logo">ISAGI OS</div><div class="mut small">RPG D’AUTO-ÉVOLUTION · V1</div><nav id="nav"></nav><div style="position:absolute;bottom:15px;font-size:11px;color:var(--mut);line-height:1.5">Données &gt; impressions<br>Capacité réelle &gt; chiffres</div></aside><main id="main"></main></div>
<div id="modal" class="modal"><div class="box"><div class="between"><h2 id="mtitle"></h2><button class="btn" onclick="closeM()">×</button></div><div id="mbody"></div></div></div><div id="toast" class="toast"></div>
<script>
const KEY='isagi_os_v1';const base={xp:0,level:1,stats:{Ambition:7,'Gestion émotionnelle':6,Sociabilité:4.5,Communication:5,Confiance:6.5,Adaptabilité:5,'Prise de décision':5,Discipline:7.5},facts:[],hypotheses:[{id:1,title:'Recherche de formulation parfaite',confidence:0.55,status:'À tester',text:'Dans certaines situations sociales imprévisibles, l’anticipation pourrait ralentir l’action.'}],experiments:[{id:1,title:'Réponse immédiate',hyp:'Une réponse simple dans les 2 secondes peut réduire la suranalyse à faible enjeu.',result:'',xp:25,status:'À tester'}],quests:[{id:1,title:'Réponse immédiate',type:'Principale',desc:'Tester l’action rapide dans une situation sociale simple.',xp:25,done:false},{id:2,title:'Cartographier le jugement',type:'Exploration',desc:'Séparer fait, interprétation et hypothèses après une interaction.',xp:20,done:false}],skills:[{name:'Écoute',v:7.5,proof:2,need:3,desc:'Rester engagé et retenir l’information utile.'},{name:'Présence',v:6,proof:1,need:3,desc:'Rester présent sans surveiller excessivement son image.'},{name:'Spontanéité',v:4.5,proof:0,need:3,desc:'Agir sans attendre une formulation parfaite.'},{name:'Régulation',v:6,proof:1,need:4,desc:'Ressentir une émotion sans lui céder automatiquement le contrôle.'},{name:'Lecture sociale',v:4.5,proof:0,need:4,desc:'Distinguer signaux, contexte et interprétation.'},{name:'Adaptation',v:5,proof:0,need:4,desc:'Modifier volontairement sa réponse selon le contexte.'}],bosses:[{name:'Suranalyse sociale',threat:'Élevée',progress:0,trigger:'Attention sociale / imprévisibilité',mechanism:'Gêne → anticipation → hésitation → analyse postérieure',weakness:'Action simple à faible enjeu'}],weapons:[],replays:[],achievements:[],versions:[{name:'V0',text:'Point de départ : analyse forte, écoute solide, aisance variable selon le contexte, jugement extérieur important à tester.',date:new Date().toLocaleDateString('fr-FR')}],events:[]};let d=JSON.parse(localStorage.getItem(KEY)||'null')||base;function save(){localStorage.setItem(KEY,JSON.stringify(d));render()}function need(){return 100+(d.level-1)*50}function xp(n){d.xp+=+n;let up=false;while(d.xp>=need()){d.xp-=need();d.level++;up=true}if(up)toast('Évolution : niveau '+d.level);save()}function toast(t){let x=document.getElementById('toast');x.textContent=t;x.classList.add('on');setTimeout(()=>x.classList.remove('on'),2200)}
const tabs=[['dash','Dashboard'],['quests','Quêtes'],['skills','Compétences'],['bosses','Boss'],['arsenal','Arsenal'],['replay','Replay'],['lab','Laboratoire'],['model','Modèle'],['profile','Profil']];let current='dash';function nav(){document.getElementById('nav').innerHTML=tabs.map(x=>`<button class="${x[0]==current?'on':''}" onclick="go('${x[0]}')">${x[1]}</button>`).join('')}function go(x){current=x;render()}function card(x){return `<div class="card">${x}</div>`}
function render(){nav();let m=document.getElementById('main');m.innerHTML=views[current]();}
function views(){return{dash:dashboard,quests:quests,skills:skills,bosses:bosses,arsenal:arsenal,replay:replay,lab:lab,model:model,profile:profile}} 
function dashboard(){let n=need();return `<section class="section on"><div class="top"><div><div class="k">Command center</div><h1>Construis ta prochaine version.</h1><div class="mut">Le RPG sert l’évolution réelle.</div></div><div class="row"><button class="btn primary" onclick="expModal()">+ Expérience</button><button class="btn" onclick="factModal()">+ Donnée</button></div></div><div class="grid g4">${card(`<div class="mut small">Niveau</div><div class="big">${d.level}</div><div class="bar"><i style="width:${d.xp/n*100}%"></i></div><div class="small mut">${d.xp}/${n} XP</div>`)}${card(`<div class="mut small">Hypothèses</div><div class="big">${d.hypotheses.length}</div><div class="small mut">${d.hypotheses.filter(h=>h.status==='À tester').length} à tester</div>`)}${card(`<div class="mut small">Boss</div><div class="big">${d.bosses.length}</div><div class="small mut">${d.bosses.filter(b=>b.progress<100).length} actifs</div>`)}${card(`<div class="mut small">Données</div><div class="big">${d.facts.length}</div><div class="small mut">${d.experiments.length} expériences</div>`)}</div><div class="grid g2" style="margin-top:13px">${card(`<h2>Statistiques</h2>${Object.entries(d.stats).map(([k,v])=>`<div class="stat" style="margin:9px 0"><div class="between"><span>${k}</span><b>${v}/10</b></div><div class="bar"><i style="width:${v*10}%"></i></div></div>`).join('')}`)}${card(`<h2>Première expérience</h2><div class="item"><span class="tag">HYPOTHÈSE</span><p class="line">${d.hypotheses[0].text}</p><button class="btn primary" style="margin-top:8px" onclick="expModal()">Lancer / rapporter</button></div>`)}</div><div style="margin-top:13px">${card(`<h2>État du système</h2><div class="line mut">Version actuelle : V${d.level}. Le niveau n’est qu’un indicateur. Une compétence ne devient maîtrisée qu’avec des preuves répétées et transférées. Si les données contredisent une hypothèse, elle doit être mise à jour.</div>`)}</div></section>`}
function quests(){return `<section class="section on"><div class="top"><div><div class="k">Missions</div><h1>Quêtes</h1></div><button class="btn primary" onclick="questModal()">+ Quête</button></div><div class="grid g3">${['Principale','Secondaire','Exploration'].map(t=>card(`<h2>${t}</h2>${d.quests.filter(q=>q.type===t).map(q=>`<div class="item" style="margin:8px 0;opacity:${q.done?.55:1}"><div class="between"><b>${q.title}</b><span class="tag">${q.xp} XP</span></div><p class="mut">${q.desc}</p><button class="btn" onclick="toggleQ(${q.id})">${q.done?'Rouvrir':'Valider'}</button></div>`).join('')||'<div class="mut small">Aucune.</div>'}`)).join('')}</div></section>`}
function skills(){return `<section class="section on"><div class="k">Preuves comportementales</div><h1>Compétences</h1><div class="grid g3" style="margin-top:18px">${d.skills.map(s=>card(`<div class="between"><h2>${s.name}</h2><span class="tag">${s.proof}/${s.need} preuves</span></div><div class="big" style="font-size:22px">${s.v}/10</div><div class="bar" style="margin:7px 0"><i style="width:${s.v*10}%"></i></div><div class="mut small">${s.desc}</div><div class="small" style="margin-top:8px;color:${s.proof>=s.need?'var(--a)':'var(--mut)'}">${s.proof>=s.need?'✓ INTÉGRÉE':'◐ EN VALIDATION'}</div>`)).join('')}</div></section>`}
function bosses(){return `<section class="section on"><div class="k">Difficultés récurrentes</div><h1>Boss actifs</h1><div class="grid g2" style="margin-top:18px">${d.bosses.map(b=>card(`<div class="between"><h2>⚔ ${b.name}</h2><span class="tag">${b.threat}</span></div><div class="small mut">Déclencheur</div><p>${b.trigger}</p><div class="small mut">Mécanisme</div><p>${b.mechanism}</p><div class="small mut">Faiblesse potentielle</div><p>${b.weakness}</p><div class="bar"><i style="width:${b.progress}%"></i></div><div class="small mut">Maîtrise ${b.progress}%</div>`)).join('')}</div></section>`}
function arsenal(){return `<section class="section on"><div class="top"><div><div class="k">Techniques éprouvées</div><h1>Arsenal</h1></div><button class="btn primary" onclick="weaponModal()">+ Arme</button></div><div class="grid g3">${d.weapons.map(w=>card(`<h2>◈ ${w.name}</h2><p>${w.effect}</p><div class="small mut">Conditions</div><p>${w.cond}</p><div class="small mut">Preuves</div><p>${w.proof}</p>`)).join('')||card('<div class="mut">Aucune arme validée. Une stratégie n’entre ici qu’après plusieurs preuves pertinentes.</div>')}</div></section>`}
function replay(){return `<section class="section on"><div class="top"><div><div class="k">Analyse de match</div><h1>Replay</h1></div><button class="btn primary" onclick="replayModal()">+ Replay</button></div><div class="grid">${d.replays.map(r=>card(`<h2>${r.title}</h2><div class="grid g3"><div><b>Perception</b><p class="mut">${r.p}</p></div><div><b>Interprétation</b><p class="mut">${r.i}</p></div><div><b>Émotion → décision → résultat</b><p class="mut">${r.e}<br>${r.a}<br>${r.r}</p></div></div>`)).join('')||card('<div class="mut">Aucun replay.</div>')}</div></section>`}
function lab(){return `<section class="section on"><div class="top"><div><div class="k">Laboratoire</div><h1>Expériences & données</h1></div><button class="btn primary" onclick="expModal()">+ Expérience</button></div><div class="grid g2">${card(`<h2>Expériences</h2>${d.experiments.map(e=>`<div class="item" style="margin:8px 0"><div class="between"><b>${e.title}</b><span class="tag">${e.status}</span></div><p><b>Hypothèse :</b> ${e.hyp}</p><p><b>Résultat :</b> ${e.result||'À rapporter.'}</p></div>`).join('')}`)}${card(`<h2>Faits bruts</h2>${d.facts.map(f=>`<div class="item" style="margin:8px 0"><b>${f.date}</b><p>${f.text}</p></div>`).join('')||'<div class="mut">Ajoute des faits observables. Pas d’interprétation nécessaire ici.</div>'}`)}</div></section>`}
function model(){return `<section class="section on"><div class="k">Modèle probabiliste</div><h1>Hypothèses & angles morts</h1><div class="grid g2" style="margin-top:18px">${card(`<h2>Hypothèses en cours</h2>${d.hypotheses.map(h=>`<div class="item" style="margin:8px 0"><div class="between"><b>${h.title}</b><span class="tag">${Math.round(h.confidence*100)}% confiance</span></div><p>${h.text}</p><div class="small mut">Statut : ${h.status}</div></div>`).join('')}`)}${card(`<h2>Protocole</h2><div class="line mut">FAIT → INTERPRÉTATION → HYPOTHÈSE → EXPÉRIENCE → RÉSULTAT → MISE À JOUR.<br><br>Une hypothèse peut être renforcée, affaiblie ou détruite. Le système ne protège aucune théorie contre les nouvelles données.</div>`)}</div></section>`}
function profile(){return `<section class="section on"><div class="top"><div><div class="k">Identité évolutive</div><h1>Profil & versions</h1></div><button class="btn danger" onclick="resetAll()">Réinitialiser</button></div><div class="grid g2">${card(`<h2>Règle d’or</h2><div class="line mut">Les statistiques représentent une maîtrise fonctionnelle, jamais une valeur humaine. Le build est temporaire. La personnalité actuelle est une hypothèse, pas une prison.</div>`)}${card(`<h2>Versions</h2>${d.versions.map(v=>`<div class="item" style="margin:8px 0"><b>${v.name}</b><p>${v.text}</p><span class="small mut">${v.date}</span></div>`).join('')}`)}</div></section>`}
function open(title,body){document.getElementById('mtitle').textContent=title;document.getElementById('mbody').innerHTML=body;document.getElementById('modal').classList.add('on')}function closeM(){document.getElementById('modal').classList.remove('on')}
function expModal(){open('Nouvelle expérience',`<form class="form" onsubmit="addExp(event)"><input id="xname" required placeholder="Nom de l’expérience"><input id="xhyp" required placeholder="Hypothèse testée"><textarea id="xres" placeholder="Résultat réel (même si échec)"></textarea><input id="xxp" type="number" min="5" value="25"><button class="btn primary">Enregistrer</button></form>`)}function factModal(){open('Ajouter un fait',`<form class="form" onsubmit="addFact(event)"><textarea id="ftext" required placeholder="Décris uniquement ce qui s’est objectivement passé."></textarea><button class="btn primary">Enregistrer</button></form>`)}function questModal(){open('Nouvelle quête',`<form class="form" onsubmit="addQuest(event)"><input id="qname" required placeholder="Nom"><select id="qtype"><option>Principale</option><option>Secondaire</option><option>Exploration</option></select><textarea id="qdesc" placeholder="Objectif / test"></textarea><input id="qxp" type="number" value="20"><button class="btn primary">Créer</button></form>`)}function weaponModal(){open('Nouvelle arme',`<form class="form" onsubmit="addWeapon(event)"><input id="wn" required placeholder="Nom"><input id="we" placeholder="Effet"><input id="wc" placeholder="Conditions"><textarea id="wp" placeholder="Preuves"></textarea><button class="btn primary">Ajouter</button></form>`)}function replayModal(){open('Nouveau replay',`<form class="form" onsubmit="addReplay(event)"><input id="rn" required placeholder="Situation"><textarea id="rp" placeholder="Perception"></textarea><textarea id="ri" placeholder="Interprétation"></textarea><textarea id="re" placeholder="Émotion"></textarea><textarea id="ra" placeholder="Décision / action"></textarea><textarea id="rr" placeholder="Résultat"></textarea><button class="btn primary">Enregistrer</button></form>`)}
function addExp(e){e.preventDefault();let x={id:Date.now(),title:xname.value,hyp:xhyp.value,result:xres.value,xp:+xxp.value,status:xres.value?'À analyser':'À rapporter'};d.experiments.unshift(x);xp(x.xp);closeM()}function addFact(e){e.preventDefault();d.facts.unshift({text:ftext.value,date:new Date().toLocaleString('fr-FR')});save();closeM();toast('Fait enregistré.')}function addQuest(e){e.preventDefault();d.quests.push({id:Date.now(),title:qname.value,type:qtype.value,desc:qdesc.value,xp:+qxp.value,done:false});save();closeM();toast('Quête créée.')}function addWeapon(e){e.preventDefault();d.weapons.unshift({name:wn.value,effect:we.value,cond:wc.value,proof:wp.value});save();closeM();toast('Arme ajoutée.')}function addReplay(e){e.preventDefault();d.replays.unshift({title:rn.value,p:rp.value,i:ri.value,e:re.value,a:ra.value,r:rr.value});save();closeM();toast('Replay enregistré.')}function toggleQ(id){let q=d.quests.find(x=>x.id===id);if(!q)return;if(!q.done){q.done=true;xp(q.xp)}else{q.done=false;save()}}function resetAll(){if(confirm('Effacer toutes les données du RPG ?')){localStorage.removeItem(KEY);d=JSON.parse(JSON.stringify(base));render();toast('Système réinitialisé.')}}render();
</script></body></html>
